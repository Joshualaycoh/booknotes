<%- include("partials/header.ejs") %>

<div class="container mt-5">
    <form action="/create" method="POST" enctype="multipart/form-data" class="bg-white p-4 rounded shadow-sm">
        <!-- Book Cover Upload -->
        <div class="text-center mb-4">
            <img src="/images/book.jpg" alt="Book Cover" id="coverImg" class="img-fluid rounded mb-3" style="max-height: 300px; width: auto;">
            <label for="profile-pic" class="btn btn-outline-primary">
                <i class="fas fa-upload me-2"></i>Upload Book Cover
            </label>
            <input type="file" class="d-none" name="profile" accept="image/jpg, image/png, image/jpeg" id="profile-pic">
        </div>

        <!-- Title and Author -->
        <div class="mb-3">
            <label for="title" class="form-label fw-bold">Title and Author</label>
            <input type="text" class="form-control" id="title" name="title" required>
        </div>

        <!-- Book Rating -->
        <div class="mb-3">
            <label for="rating" class="form-label fw-bold">Book Rating</label>
            <select class="form-select" id="rating" name="rating" required>
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
                <option value="5">5</option>
                <option value="6">6</option>
                <option value="7">7</option>
                <option value="8">8</option>
                <option value="9">9</option>
                <option value="10">10</option>
            </select>
        </div>

        <!-- Overview -->
        <div class="mb-3">
            <label for="overview" class="form-label fw-bold">Overview</label>
            <textarea class="form-control" id="overview" name="overview" rows="4" required></textarea>
        </div>

        <!-- Notes -->
        <div class="mb-4">
            <label for="notes" class="form-label fw-bold">Notes</label>
            <textarea class="form-control" id="notes" name="notes" rows="4" required></textarea>
        </div>

        <!-- Submit Button -->
        <div class="text-center">
            <button type="submit" class="btn btn-primary w-100">
                <i class="fas fa-paper-plane me-2"></i>Post
            </button>
        </div>
    </form>
</div>



<%- include("partials/footer.ejs") %>
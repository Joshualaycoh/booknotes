    <script>
      // Update book cover image when a file is selected
      let coverImage = document.getElementById("coverImg");
      let inputFile = document.getElementById("profile-pic");
  
      inputFile.onchange = function () {
          coverImage.src = URL.createObjectURL(inputFile.files[0]);
      };
  </script>
 

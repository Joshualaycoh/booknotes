<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Booknotes - Unlock the Wisdom Between Pages</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link rel="stylesheet" href="/styles/home.css">
</head>
<body>

<section class="hero-section">
  <div class="hero-content">
    <h1>Unlock the Wisdom Between Pages</h1>
    <p>Your personal space to store, organize, and share book notes.</p>
    <div>
      <a href="/register" class="btn btn-primary">Sign Up</a>
      <a href="/login" class="btn btn-outline-light">Login</a>
    </div>
  </div>
</section>

<section class="features-section">
  <div class="container">
    <h2>Why Choose Booknotes?</h2>
    <div class="row">
      <div class="col-md-4">
        <div class="feature-card">
          <img src="/images/banner-2.png" alt="Organize Notes">
          <h3>Organize Notes</h3>
          <p>Easily categorize and manage your book notes for quick access.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="feature-card">
          <img src="/images/banner-3.png" alt="Share Insights">
          <h3>Share Insights</h3>
          <p>Share your notes with friends or the community to inspire others.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="feature-card">
          <img src="/images/banner-1.png" alt="Discover Books">
          <h3>Discover Books</h3>
          <p>Explore recommendations and notes from other readers.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="footer">
  <p>&copy; <script>document.write(new Date().getFullYear());</script> Booknotes. All rights reserved.</p>
</footer>

</body>
</html>
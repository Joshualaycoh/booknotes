<%- include("partials/header.ejs") %>

<div class="container mt-5">
    <div class="row">
        <% for(let note of titles) { %>
        <div class="col-lg-3 col-md-6 col-12 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="/images/<%= note.profile %>" alt="<%= note.book_title %>" class="card-img-top" style="height: 300px; object-fit: cover;">
                <div class="card-body">
                    <h4 class="card-title"><%= note.book_title %></h4>
                    <small class="text-muted d-block mb-2">Rating: <strong><%= note.rating %></strong>/10</small>
                    <p class="card-text text-muted" style="font-size: 0.9rem; line-height: 1.5; max-height: 80px; overflow: hidden; text-overflow: ellipsis;"><%= note.overview %></p>
                    <form action="/book" method="post">
                        <button type="submit" name="booknotes" value="<%= note.id %>" class="btn btn-primary w-100">Read More</button>
                    </form>
                </div>
            </div>
        </div>
        <% } %>
    </div>
</div>

<div class="col-12 d-flex justify-content-center my-5">
    <nav aria-label="Page navigation">
        <ul class="pagination">
            <li class="page-item"><a class="page-link" href="#">«</a></li>
            <li class="page-item"><a class="page-link active" href="#">1</a></li>
            <li class="page-item"><a class="page-link" href="#">2</a></li>
            <li class="page-item"><a class="page-link" href="#">3</a></li>
            <li class="page-item"><a class="page-link" href="#">4</a></li>
            <li class="page-item"><a class="page-link" href="#">»</a></li>
        </ul>
    </nav>
</div>

